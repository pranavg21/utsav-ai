exports[`Gemini 2.5 Flash Prompt Templates (5 Capabilities) > 1. buildPlanGenerationPrompt includes serialized context and matches snapshot 1`] = `
"Generate an execution plan for this Indian event.
INPUT_CONTEXT_JSON: {"occasion":"wedding","eventName":"Grand Family Wedding","totalBudget":800000,"guestCount":200,"daysUntilEvent":120,"experienceTier":"grand","priorityRanking":["Catering & Hospitality","Venue & Logistics","Photography & Media","Decor & Ambience","Entertainment & Rituals","Contingency Reserve"],"mustHaves":["Live music","Traditional rituals stage"]}

Output JSON with budgetAllocations, subEvents, and timelineTasks. Never invent confirmed vendor pricing; label all amounts as estimates."
`;

exports[`Gemini 2.5 Flash Prompt Templates (5 Capabilities) > 2. buildChangeRequestPrompt safely JSON-delimits arbitrary user injection text 1`] = `
